{
  // Deployable as it stands, by anyone: the Deploy to Cloudflare button (see
  // README) provisions the D1 database and KV namespace below in the
  // deployer's own account and rewrites their ids, and nothing here belongs to
  // one particular deployment. Secrets go in Worker secrets - the ones a
  // deployment needs are listed in .dev.vars.example.
  //
  // `npm run deploy:cli` (scripts/deploy.mjs) does the same from a terminal and
  // writes the ids it creates into this file, so expect it to be dirty in your
  // working tree afterwards.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flareid-idp",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // node:crypto, which is not used yet but is what any future SAML support
  // needs for X.509 handling - see SAML-implementation.md.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Hourly garbage collection of expired codes, tokens, sessions, trusted
  // devices and old audit entries - see src/lib/cleanup.ts.
  "triggers": {
    "crons": ["23 * * * *"]
  },
  "vars": {
    // Public app name shown on the login and admin pages. Also editable at
    // runtime from Admin -> Branding, which takes precedence over this.
    "APP_NAME": "FlareID",
    // Account id for the performance dashboard on the admin overview, read
    // back from Analytics Engine with the CF_ANALYTICS_TOKEN secret. Optional.
    "CF_ACCOUNT_ID": "",
    // The issuer this IdP identifies itself as, in OIDC discovery, every
    // id_token and the SAML metadata. Relying parties must match it exactly.
    // Empty: worked out at runtime (src/lib/issuer.ts) - the origin first-run
    // setup at /setup was completed on, stored then and never changed. So add
    // a custom domain BEFORE running setup and open /setup on it, or set this
    // to pin the issuer (it then wins over the stored one).
    "ISSUER_URL": ""
    // Signing keys are generated and kept in D1, encrypted with the
    // KEY_ENCRYPTION_KEY secret (src/lib/signing-keys.ts) - nothing here. To
    // import an existing RS256 key instead, set SIGNING_KEY_PKCS8 (secret) and
    // SIGNING_PUBLIC_JWK / SIGNING_KEY_ID here before the first token is signed.
    //
    // SAML is off until SAML_SIGNING_KEY_PKCS8 and SAML_SIGNING_CERT are both
    // set as secrets: `npm run saml:keygen` prints the pair.
  },
  "assets": {
    // Static files - the logo and favicons - served directly, falling through
    // to the Worker for everything else. No ASSETS binding, since nothing in
    // code fetches them programmatically.
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareid-db",
      "database_id": "f9ea9faa-9016-4e75-af71-5c654093cd44",
      "migrations_dir": "migrations"
    }
  ],
  // Per-request performance data points (src/lib/metrics.ts); read back on the
  // admin overview when CF_ANALYTICS_TOKEN is set as a secret.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "flareid_requests" }],
  "kv_namespaces": [
    {
      // Short-lived login-flow state, pending MFA challenges, and rate-limit
      // counters. Nothing in here needs to survive being lost.
      "binding": "SESSIONS_KV",
      "id": "af20f3a4a88e40329062d78a2fc86f99"
    }
  ],
  // Outbound email (Cloudflare Email Sending) for password recovery and
  // invitations. Sending also needs a From address set in Admin -> Integrations
  // -> Email, on a domain onboarded with `wrangler email sending enable`.
  "send_email": [{ "name": "EMAIL" }],
  // Edge flood control for anonymous routes (src/lib/edge-limit.ts), counted in
  // memory per Cloudflare location - no storage writes. Per client IP, per
  // minute; generous on purpose, because the brute-force control is the
  // per-account throttle, not this. namespace_id is account-wide: pick values
  // no other Worker in the account uses, or they will share counters.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "7341", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "7342", "simple": { "limit": 600, "period": 60 } }
  ]
  // Secrets, set with `wrangler secret put` (or the dashboard) rather than
  // stored here - see .dev.vars.example:
  //   BOOTSTRAP_TOKEN        - required. Authenticates first-run setup, at /setup
  //                            or POST /api/v1/setup. It stops working once setup
  //                            completes, except for the documented break-glass
  //                            route. See docs/api.md.
  //   KEY_ENCRYPTION_KEY     - required. Encrypts the signing keys stored in D1.
  //                            Never change it afterwards.
  //   SAML_SIGNING_KEY_PKCS8 - optional, with SAML_SIGNING_CERT: SAML signing,
  //   SAML_SIGNING_CERT        from `npm run saml:keygen`.
  //   CF_ANALYTICS_TOKEN     - optional, Account Analytics:Read, with CF_ACCOUNT_ID.
  //   TURNSTILE_SECRET_KEY   - optional, overrides the one saved in the console.
}
