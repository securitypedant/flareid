{
  "name": "flareid",
  "version": "0.1.0",
  "description": "A small, standalone OpenID Connect identity provider for Cloudflare Workers and D1",
  "license": "Apache-2.0",
  "author": "Simon Thorpe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securitypedant/flareid.git"
  },
  "homepage": "https://github.com/securitypedant/flareid#readme",
  "bugs": {
    "url": "https://github.com/securitypedant/flareid/issues"
  },
  "keywords": [
    "oidc",
    "openid-connect",
    "identity-provider",
    "cloudflare-workers",
    "sso"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.mjs",
    "deploy:worker-only": "wrangler deploy",
    "db:migrations:local": "wrangler d1 migrations apply flareid-db --local",
    "db:migrations:remote": "wrangler d1 migrations apply flareid-db --remote",
    "keygen": "node scripts/generate-keypair.mjs"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "jose": "^6.2.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.130.0"
  }
}
