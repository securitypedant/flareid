{
  "name": "flareid",
  "version": "3.0.0",
  "description": "A small, standalone OpenID Connect identity provider for Cloudflare Workers and D1",
  "license": "Apache-2.0",
  "author": "Simon Thorpe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securitypedant/flareid.git"
  },
  "homepage": "https://github.com/securitypedant/flareid#readme",
  "bugs": {
    "url": "https://github.com/securitypedant/flareid/issues"
  },
  "keywords": [
    "oidc",
    "openid-connect",
    "identity-provider",
    "cloudflare-workers",
    "sso"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node scripts/deploy.mjs",
    "deploy:worker-only": "wrangler deploy",
    "db:migrations:local": "wrangler d1 migrations apply flareid-db --local",
    "db:migrations:remote": "wrangler d1 migrations apply flareid-db --remote",
    "keygen": "node scripts/generate-keypair.mjs",
    "saml:keygen": "node scripts/generate-saml-cert.mjs",
    "test-data": "node scripts/generate-test-directory.mjs",
    "oidc:conformance": "node scripts/oidc-conformance.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "hono": "4.13.14",
    "jose": "^6.2.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "node-forge": "^1.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0",
    "xml-crypto": "^6.4.0"
  }
}
